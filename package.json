{
    "name": "@lynx-lab/crypto",
    "version": "1.0.3",
    "description": "Cryptographically secure random values for Lynx \u2014 crypto.getRandomValues and crypto.randomUUID, backed by SecureRandom and SecRandomCopyBytes.",
    "license": "MIT",
    "author": "PopLocker714",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PopLocker714/lynx-crypto.git"
    },
    "bugs": "https://github.com/PopLocker714/lynx-crypto/issues",
    "homepage": "https://github.com/PopLocker714/lynx-crypto#readme",
    "keywords": [
        "lynx",
        "lynxjs",
        "lynx-native-module",
        "crypto",
        "getRandomValues",
        "csprng",
        "uuid",
        "webcrypto"
    ],
    "exports": {
        "./package.json": "./package.json",
        "./lynx.lib.json": "./lynx.lib.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js",
            "default": "./dist/testing/index.js"
        }
    },
    "files": [
        "dist",
        "src/**/*.ts",
        "!src/__tests__/**",
        "android",
        "!android/build",
        "!android/.gradle",
        "ios",
        "lynx.lib.json",
        "LICENSE",
        "README.md",
        "README.ru.md",
        "docs",
        "CONTRIBUTING.md",
        "CONTRIBUTING.ru.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "lint": "biome check --error-on-warnings .",
        "format": "biome format --write .",
        "test": "vitest run",
        "prepack": "bun run build",
        "prepublishOnly": "bun run check",
        "release": "semantic-release",
        "check:package": "bun scripts/check-publishable.mjs",
        "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:package",
        "format:native": "bun scripts/native-tools.mjs format",
        "check:android": "bun scripts/check-android.mjs",
        "check:ios": "bun scripts/check-ios.mjs",
        "check:consumer": "bun scripts/check-consumer.mjs"
    },
    "peerDependencies": {
        "@lynx-js/types": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@lynx-js/types": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.9",
        "@lynx-js/types": "^4.1.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/node": "22.19.21",
        "conventional-changelog-conventionalcommits": "^9.0.0",
        "semantic-release": "^25.0.9",
        "typescript": "5.9.3",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "packageManager": "bun@1.4.0"
}
